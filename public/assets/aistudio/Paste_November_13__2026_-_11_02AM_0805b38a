<style>/* Weather Widget Container */
        .weather-widget {
            font-family: 'DM Sans';
            width: 250px;
            padding: 10px;
            border-radius: 8px;
            background-color: #fff;
            color: #000;
            text-align: left;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 10px;
        }

        /* Weather Info Container */
        .weather-info {
            display: flex;
            flex-direction: column;
            margin-right: 10px;
            flex-grow: 1;
        }

        /* City Name and Temperature on the Same Row */
        .location-temperature {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        #location {
            text-transform: uppercase;
            font-weight: 800;
        }

        /* City Name */
        .weather-widget h2 {
            font-size: 14px;
            margin: 0;
            text-transform: capitalize;
            margin-right: 5px;
        }

        /* Temperature */
        .temperature {
            font-size: 18px;
            font-weight: bold;
            margin: 0;
        }

        /* Weather Description */
        .description {
            font-size: 12px;
            margin: 5px 0 0;
            text-transform: capitalize;
        }

        /* Weather Icon */
        .weather-icon {
            font-size: 28px;
            margin-left: 10px;
        }</style></head><body><div id="weather-container"><div class="weather-widget" id="weather-widget"><div class="weather-info"><div class="location-temperature"><h2 id="location">City Name</h2><div class="temperature" id="temperature">--°C</div></div><div class="description" id="description">Description</div></div></div></div><script src="data:text/javascript;base64," defer></script></body></html></div></div></div><div class="elementor-element elementor-element-3ee3b8e elementor-hidden-mobile elementor-hidden-tablet e-flex e-con-boxed e-con e-child" data-id="3ee3b8e" data-element_type="container" data-e-type="container"><div class="e-con-inner"><div class="elementor-element elementor-element-cb0c640 elementor-nav-menu__align-end elementor-nav-menu--dropdown-tablet elementor-nav-menu__text-align-aside elementor-nav-menu--toggle elementor-nav-menu--burger elementor-widget elementor-widget-nav-menu" data-id="cb0c640" data-element_type="widget" data-e-type="widget" data-settings="{&quot;layout&quot;:&quot;horizontal&quot;,&quot;submenu_icon&quot;:{&quot;value&quot;:&quot;&lt;svg aria-hidden=\&quot;true\&quot; class=\&quot;e-font-icon-svg e-fas-caret-down\&quot; viewBox=\&quot;0 0 320 512\&quot; xmlns=\&quot;http:\/\/www.w3.org\/2000\/svg\&quot;&gt;&lt;path d=\&quot;M31.3 192h257.3c17.8 0 26.7 21.5 14.1 34.1L174.1 354.8c-7.8 7.8-20.5 7.8-28.3 0L17.2 226.1C4.6 213.5 13.5 192 31.3 192z\&quot;&gt;&lt;\/path&gt;&lt;\/svg&gt;&quot;,&quot;library&quot;:&quot;fa-solid&quot;},&quot;toggle&quot;:&quot;burger&quot;}" data-widget_type="nav-menu.default"><nav aria-label="Menu" class="elementor-nav-menu--main elementor-nav-menu__container elementor-nav-menu--layout-horizontal e--pointer-underline e--animation-fade"><ul id="menu-1-cb0c640" class="elementor-nav-menu"><li class="menu-item menu-item-type-post_type menu-item-object-page menu-item-has-children menu-item-16683"><a href="https://www.gov.ls/about-lesotho/" class="elementor-item">About Lesotho<span class="sub-arrow"><svg 